{
  "permissions": {
    "allow": [
      "PowerShell(pnpm *)",
      "PowerShell(Move-Item *)",
      "PowerShell(New-Item *)",
      "PowerShell(pnpm install *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm dev *)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000\" -TimeoutSec 10 -ErrorAction Stop; Write-Host \"HTTP $\\($r.StatusCode\\) - $\\($r.Content.Length\\) bytes\" } catch { Write-Host \"Error: $_\" })"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
